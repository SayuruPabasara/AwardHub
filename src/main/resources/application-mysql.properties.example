# =============================
# MySQL — local dev convenience only, NOT the graded/deployed target.
# Only use this if MSSQL genuinely isn't available on your machine.
# The one thing to double check going the other way: fields declared with
# columnDefinition = "TEXT" (e.g. Nomination.description, User.bio) are
# written literally into the DDL either engine runs, so schema drift here
# is unlikely, but if you add a new long-text field, prefer @Lob with no
# explicit columnDefinition so Hibernate picks the right type per dialect.
# =============================
spring.datasource.url=jdbc:mysql://localhost:3306/awardhub?createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=CHANGE_ME
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
